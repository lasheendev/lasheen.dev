// Cloudflare Workers config: serves the prerendered site in build/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lasheen-dev",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build",
    // /about serves about.html; /blog/post redirects to /blog/post/ like the old blog URLs.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get build/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
