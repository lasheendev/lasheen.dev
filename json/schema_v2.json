{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Projects Schema",
    "description": "Schema for personal projects portfolio",
    "type": "object",
    "required": ["projects"],
    "properties": {
      "$schema": {
        "type": "string",
        "description": "Path to the JSON schema file"
      },
      "projects": {
        "type": "array",
        "description": "List of projects",
        "items": {
          "type": "object",
          "required": ["id", "title", "shortDescription", "date", "category", "tags", "access"],
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier for the project"
            },
            "title": {
              "type": "string",
              "description": "Project title"
            },
            "shortDescription": {
              "type": "string",
              "description": "Brief description of the project"
            },
            "date": {
              "type": "string",
              "description": "Project release date (YYYY-MM-DD)",
              "format": "date"
            },
            "category": {
              "type": "string",
              "enum": ["client", "employment", "personal"],
              "description": "client: built for a client through lasheen.dev; employment: built in a full-time job; personal: my own apps and open source"
            },
            "employer": {
              "type": "string",
              "description": "Company name, for employment projects"
            },
            "status": {
              "type": "string",
              "enum": ["live", "discontinued"],
              "description": "discontinued: no longer available in the stores (defaults to live)"
            },
            "tags": {
              "type": "array",
              "description": "Project categories/technologies",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "backgroundImageSource": {
              "type": "string",
              "description": "URL to project screenshot or logo image",
              "format": "uri"
            },
            "access": {
              "type": "array",
              "description": "Links to access the project",
              "items": {
                "type": "object",
                "required": ["id", "icon", "color", "url"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Link identifier (e.g., Github, Playstore)"
                  },
                  "icon": {
                    "type": "string",
                    "description": "Icon identifier for the link"
                  },
                  "color": {
                    "type": "string",
                    "description": "Color for the icon (hex or named color)"
                  },
                  "url": {
                    "type": "string",
                    "description": "URL to access the project",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      }
    }
  }