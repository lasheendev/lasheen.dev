# Cloudflare static asset headers (copied into build/ by SvelteKit).
# https://developers.cloudflare.com/workers/static-assets/headers/

# Hashed JS, CSS and font files from the build: their names change whenever
# their contents do, so browsers can keep them forever.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Project preview images. Cached for a year, so when you replace an image,
# give it a new filename (e.g. sn-2.webp) and update json/projects_v2.json.
/images/*
  Cache-Control: public, max-age=31536000, immutable
